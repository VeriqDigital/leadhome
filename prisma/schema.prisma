generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                              String                                   @id @default(cuid())
  name                            String?
  email                           String                                   @unique
  emailVerified                   DateTime?
  image                           String?
  passwordHash                    String?
  accounts                        Account[]
  leads                           Lead[]
  leadActivities                  LeadActivity[]
  inboundSources                  InboundSource[]
  communicationAccounts           CommunicationAccount[]
  conversations                   Conversation[]
  messages                        Message[]
  tasks                           Task[]
  jobs                            Job[]
  conversationAnalyses            ConversationAnalysis[]
  conversationLeadMatchDismissals ConversationLeadMatchDismissal[]
  companySuggestionDismissals     ConversationCompanySuggestionDismissal[]
  conversationIntelligenceEnabled Boolean                                  @default(false)
  createdAt                       DateTime                                 @default(now())
  updatedAt                       DateTime                                 @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model InboundSource {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String              @unique
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  rateLimits  InboundRateLimit[]
  submissions InboundSubmission[]

  @@index([userId, createdAt])
}

model InboundRateLimit {
  id          String        @id @default(cuid())
  sourceId    String
  source      InboundSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  ipHash      String
  windowStart DateTime
  count       Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([sourceId, ipHash, windowStart])
  @@index([windowStart])
}

model InboundSubmission {
  id              String        @id @default(cuid())
  sourceId        String
  source          InboundSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  idempotencyHash String
  leadId          String
  lead            Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([sourceId, idempotencyHash])
  @@index([leadId])
}

model Lead {
  id                              String                                   @id @default(cuid())
  userId                          String
  user                            User                                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  inboundSubmissions              InboundSubmission[]
  activities                      LeadActivity[]
  conversations                   Conversation[]
  tasks                           Task[]
  conversationLeadMatchDismissals ConversationLeadMatchDismissal[]
  companySuggestionDismissals     ConversationCompanySuggestionDismissal[]
  name                            String
  email                           String?
  phone                           String?
  company                         String?
  source                          LeadSource                               @default(MANUAL)
  status                          LeadStatus                               @default(NEW)
  message                         String?
  estimatedValue                  Decimal?                                 @db.Decimal(12, 2)
  nextFollowUpDate                DateTime?
  createdAt                       DateTime                                 @default(now())
  updatedAt                       DateTime                                 @updatedAt

  @@unique([id, userId])
  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([userId, status, nextFollowUpDate, updatedAt, id])
  @@index([userId, status, updatedAt, id])
  @@index([userId, status, estimatedValue, id])
}

model LeadActivity {
  id             String                @id @default(cuid())
  leadId         String?
  userId         String
  conversationId String?
  messageId      String?
  taskId         String?
  type           LeadActivityType
  actorType      LeadActivityActorType @default(SYSTEM)
  source         LeadActivitySource    @default(SYSTEM)
  title          String
  description    String?
  metadata       Json?
  occurredAt     DateTime              @default(now())
  idempotencyKey String?
  createdAt      DateTime              @default(now())
  lead           Lead?                 @relation(fields: [leadId], references: [id], onDelete: SetNull)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation?         @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message        Message?              @relation(fields: [messageId], references: [id], onDelete: SetNull)
  task           Task?                 @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([messageId, type])
  @@unique([userId, idempotencyKey])
  @@index([leadId, occurredAt, id])
  @@index([userId, occurredAt, id])
  @@index([conversationId, occurredAt, id])
  @@index([taskId, occurredAt, id])
  @@index([userId, type, occurredAt, id])
  @@index([messageId, occurredAt])
}

model CommunicationAccount {
  id                String                     @id @default(cuid())
  ownerId           String
  owner             User                       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  provider          MessageProvider
  displayName       String
  address           String?
  providerAccountId String
  conversations     Conversation[]
  lastImportedAt    DateTime?
  lastImportSummary Json?
  status            CommunicationAccountStatus @default(CONNECTED)
  grantedScopes     String?
  tokenExpiresAt    DateTime?
  lastSyncError     String?
  disconnectedAt    DateTime?
  gmailCredential   GmailCredential?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@unique([ownerId, provider, providerAccountId])
  @@unique([provider, providerAccountId])
  @@unique([id, ownerId, provider])
  @@index([ownerId, createdAt])
}

model GmailCredential {
  id                     String               @id @default(cuid())
  communicationAccountId String               @unique
  communicationAccount   CommunicationAccount @relation(fields: [communicationAccountId], references: [id], onDelete: Cascade)
  encryptedRefreshToken  String
  encryptedAccessToken   String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
}

model OAuthState {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  purpose   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model Conversation {
  id                          String                                   @id @default(cuid())
  accountId                   String
  account                     CommunicationAccount                     @relation(fields: [accountId, ownerId, provider], references: [id, ownerId, provider], onDelete: Cascade)
  ownerId                     String
  owner                       User                                     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  provider                    MessageProvider
  providerConversationId      String
  leadId                      String?
  lead                        Lead?                                    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  subject                     String?
  status                      ConversationStatus                       @default(OPEN)
  classification              ConversationClassification               @default(UNKNOWN)
  classificationIsManual      Boolean                                  @default(false)
  reviewState                 ConversationReviewState                  @default(NEEDS_REVIEW)
  manuallyDetached            Boolean                                  @default(false)
  providerMetadata            Json?
  matchKind                   ConversationMatchKind?
  matchReason                 String?
  matchCandidateLeadIds       Json?
  lastMessageAt               DateTime?
  baselineImportedAt          DateTime?
  messages                    Message[]
  activities                  LeadActivity[]
  tasks                       Task[]
  analysis                    ConversationAnalysis?
  leadMatchDismissals         ConversationLeadMatchDismissal[]
  companySuggestionDismissals ConversationCompanySuggestionDismissal[]
  createdAt                   DateTime                                 @default(now())
  updatedAt                   DateTime                                 @updatedAt

  @@unique([accountId, providerConversationId])
  @@unique([id, ownerId])
  @@unique([id, ownerId, accountId])
  @@index([ownerId, updatedAt])
  @@index([leadId, updatedAt])
  @@index([ownerId, reviewState, lastMessageAt])
  @@index([ownerId, classification, lastMessageAt])
  @@index([ownerId, status, lastMessageAt, id])
  @@index([ownerId, provider, lastMessageAt, id])
}

model ConversationLeadMatchDismissal {
  id                  String       @id @default(cuid())
  ownerId             String
  owner               User         @relation(fields: [ownerId], references: [id], onDelete: Cascade, map: "ConversationLeadMatchDismissal_ownerId_fkey")
  conversationId      String
  conversation        Conversation @relation(fields: [conversationId, ownerId], references: [id, ownerId], onDelete: Cascade, map: "ConversationLeadMatchDismissal_conversation_owner_fkey")
  leadId              String
  lead                Lead         @relation(fields: [leadId, ownerId], references: [id, userId], onDelete: Cascade, map: "ConversationLeadMatchDismissal_lead_owner_fkey")
  evidenceFingerprint String
  dismissedAt         DateTime     @default(now())

  @@unique([ownerId, conversationId, leadId, evidenceFingerprint], map: "ConversationLeadMatchDismissal_owner_match_fingerprint_key")
  @@index([ownerId, conversationId, dismissedAt], map: "ConversationLeadMatchDismissal_owner_conversation_dismissed_idx")
  @@index([ownerId, leadId], map: "ConversationLeadMatchDismissal_owner_lead_idx")
}

model ConversationCompanySuggestionDismissal {
  id                  String       @id @default(cuid())
  ownerId             String
  owner               User         @relation(fields: [ownerId], references: [id], onDelete: Cascade, map: "ConversationCompanySuggestionDismissal_ownerId_fkey")
  conversationId      String
  conversation        Conversation @relation(fields: [conversationId, ownerId], references: [id, ownerId], onDelete: Cascade, map: "ConversationCompanySuggestionDismissal_conversation_owner_fkey")
  leadId              String
  lead                Lead         @relation(fields: [leadId, ownerId], references: [id, userId], onDelete: Cascade, map: "ConversationCompanySuggestionDismissal_lead_owner_fkey")
  candidateValue      String
  evidenceSource      String
  evidenceFingerprint String
  dismissedAt         DateTime     @default(now())

  @@unique([ownerId, conversationId, leadId, evidenceFingerprint], map: "CompanySuggestionDismissal_owner_candidate_fingerprint_key")
  @@index([ownerId, conversationId, leadId, dismissedAt], map: "CompanySuggestionDismissal_owner_conversation_lead_idx")
  @@index([ownerId, leadId], map: "CompanySuggestionDismissal_owner_lead_idx")
}

model Message {
  id                   String           @id @default(cuid())
  conversationId       String
  accountId            String
  conversation         Conversation     @relation(fields: [conversationId, ownerId, accountId], references: [id, ownerId, accountId], onDelete: Cascade)
  ownerId              String
  owner                User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  providerMessageId    String
  direction            MessageDirection
  sender               String
  recipients           Json
  subject              String?
  replyTo              String?
  bodyText             String?
  bodyHtml             String?
  receivedAt           DateTime
  internetMessageId    String?
  inReplyTo            String?
  references           Json?
  externalSubmissionId String?
  sourceSystem         String?
  metadata             Json?
  activities           LeadActivity[]
  createdAt            DateTime         @default(now())

  @@unique([accountId, providerMessageId])
  @@index([ownerId, receivedAt])
  @@index([ownerId, externalSubmissionId])
}

model Task {
  id             String         @id @default(cuid())
  ownerId        String
  owner          User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  leadId         String?
  lead           Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  activities     LeadActivity[]
  title          String
  description    String?
  type           TaskType       @default(GENERAL)
  priority       TaskPriority   @default(NORMAL)
  status         TaskStatus     @default(OPEN)
  dueAt          DateTime?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([ownerId, status, dueAt, id])
  @@index([ownerId, type, dueAt])
  @@index([leadId, status, dueAt])
  @@index([conversationId, status, dueAt])
}

model Job {
  id               String    @id @default(cuid())
  ownerId          String
  owner            User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  type             JobType
  status           JobStatus @default(PENDING)
  payload          Json
  result           Json?
  progress         Json?
  attemptCount     Int       @default(0)
  maxAttempts      Int       @default(3)
  availableAt      DateTime  @default(now())
  lockedAt         DateTime?
  lockedBy         String?
  heartbeatAt      DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  failedAt         DateTime?
  lastErrorCode    String?
  lastErrorMessage String?
  idempotencyKey   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([ownerId, type, idempotencyKey])
  @@index([status, availableAt, createdAt, id])
  @@index([status, heartbeatAt, lockedAt, id])
  @@index([ownerId, type, createdAt, id])
}

model ConversationAnalysis {
  id                 String                     @id @default(cuid())
  ownerId            String
  owner              User                       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  conversationId     String
  conversation       Conversation               @relation(fields: [conversationId, ownerId], references: [id, ownerId], onDelete: Cascade)
  latestJobId        String?
  status             ConversationAnalysisStatus @default(NOT_ANALYZED)
  contentHash        String?
  analysisVersion    String
  summary            String?
  structuredData     Json?
  model              String?
  inputTokens        Int?
  outputTokens       Int?
  totalTokens        Int?
  durationMs         Int?
  sourceMessageCount Int                        @default(0)
  inputTruncated     Boolean                    @default(false)
  lastErrorCode      String?
  lastErrorMessage   String?
  queuedAt           DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@unique([conversationId, ownerId])
  @@index([ownerId, status, updatedAt])
  @@index([ownerId, completedAt])
  @@index([latestJobId])
}

enum LeadSource {
  MANUAL
  WEBSITE
  GMAIL
  FACEBOOK
  PHONE
}

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  PROPOSAL_SENT
  NEGOTIATING
  WON
  LOST
}

enum LeadActivityType {
  LEAD_CREATED
  WEBSITE_SUBMISSION_RECEIVED
  CONVERSATION_IMPORTED
  STATUS_CHANGED
  ESTIMATED_VALUE_CHANGED
  FOLLOW_UP_CHANGED
  CONTACT_INFO_CHANGED
  COMPANY_CHANGED
  NOTES_CHANGED
  SOURCE_CHANGED
  MESSAGE_RECEIVED
  MESSAGE_SENT
  CONVERSATION_LINKED
  CONVERSATION_UNLINKED
  CONVERSATION_STATUS_CHANGED
  AI_ANALYSIS_COMPLETED
  TASK_CREATED
  TASK_UPDATED
  TASK_COMPLETED
  TASK_REOPENED
  TASK_CANCELLED
  TASK_DELETED
}

enum LeadActivityActorType {
  USER
  CONTACT
  SYSTEM
  AI
}

enum LeadActivitySource {
  MANUAL
  WEBSITE
  GMAIL
  INBOX
  TASK
  AI
  SYSTEM
}

enum MessageProvider {
  FAKE
  GMAIL
  OUTLOOK
  MICROSOFT_365
  FACEBOOK_MESSENGER
  INSTAGRAM
  SMS
  WHATSAPP
}

enum ConversationStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum ConversationClassification {
  UNKNOWN
  LEAD
  CUSTOMER
  NEWSLETTER
  SPAM
  INTERNAL
  SYSTEM
}

enum ConversationReviewState {
  NEEDS_REVIEW
  MATCHED
  IGNORED
  RESOLVED
}

enum ConversationMatchKind {
  MATCHED
  AMBIGUOUS
  NO_MATCH
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum CommunicationAccountStatus {
  CONNECTED
  RECONNECT_REQUIRED
  DISCONNECTED
}

enum TaskType {
  GENERAL
  CALL
  EMAIL
  MEETING
  FOLLOW_UP
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum JobType {
  GMAIL_SYNC
  CONVERSATION_ANALYSIS
  COMPANY_DETECTION
}

enum JobStatus {
  PENDING
  RUNNING
  RETRY_SCHEDULED
  COMPLETED
  FAILED
  CANCELLED
}

enum ConversationAnalysisStatus {
  NOT_ANALYZED
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  SKIPPED
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String
  leads          Lead[]
  leadActivities LeadActivity[]
  inboundSources InboundSource[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model InboundSource {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String              @unique
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  rateLimits  InboundRateLimit[]
  submissions InboundSubmission[]

  @@index([userId, createdAt])
}

model InboundRateLimit {
  id          String        @id @default(cuid())
  sourceId    String
  source      InboundSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  ipHash      String
  windowStart DateTime
  count       Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([sourceId, ipHash, windowStart])
  @@index([windowStart])
}

model InboundSubmission {
  id              String        @id @default(cuid())
  sourceId        String
  source          InboundSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  idempotencyHash String
  leadId          String
  lead            Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([sourceId, idempotencyHash])
  @@index([leadId])
}

model Lead {
  id                 String              @id @default(cuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  inboundSubmissions InboundSubmission[]
  activities         LeadActivity[]
  name               String
  email              String?
  phone              String?
  company            String?
  source             LeadSource          @default(MANUAL)
  status             LeadStatus          @default(NEW)
  message            String?
  estimatedValue     Decimal?            @db.Decimal(12, 2)
  nextFollowUpDate   DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([userId, createdAt])
  @@index([userId, status])
}

model LeadActivity {
  id          String           @id @default(cuid())
  leadId      String
  userId      String
  type        LeadActivityType
  title       String
  description String?
  metadata    Json?
  createdAt   DateTime         @default(now())
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([userId, createdAt])
}

enum LeadSource {
  MANUAL
  WEBSITE
  GMAIL
  FACEBOOK
  PHONE
}

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  PROPOSAL_SENT
  NEGOTIATING
  WON
  LOST
}

enum LeadActivityType {
  LEAD_CREATED
  WEBSITE_SUBMISSION_RECEIVED
  STATUS_CHANGED
  ESTIMATED_VALUE_CHANGED
  FOLLOW_UP_CHANGED
  CONTACT_INFO_CHANGED
  COMPANY_CHANGED
  NOTES_CHANGED
  SOURCE_CHANGED
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  emailVerified         DateTime?
  image                 String?
  passwordHash          String
  leads                 Lead[]
  leadActivities        LeadActivity[]
  inboundSources        InboundSource[]
  communicationAccounts CommunicationAccount[]
  conversations         Conversation[]
  messages              Message[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model InboundSource {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String              @unique
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  rateLimits  InboundRateLimit[]
  submissions InboundSubmission[]

  @@index([userId, createdAt])
}

model InboundRateLimit {
  id          String        @id @default(cuid())
  sourceId    String
  source      InboundSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  ipHash      String
  windowStart DateTime
  count       Int           @default(1)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([sourceId, ipHash, windowStart])
  @@index([windowStart])
}

model InboundSubmission {
  id              String        @id @default(cuid())
  sourceId        String
  source          InboundSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  idempotencyHash String
  leadId          String
  lead            Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([sourceId, idempotencyHash])
  @@index([leadId])
}

model Lead {
  id                 String              @id @default(cuid())
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  inboundSubmissions InboundSubmission[]
  activities         LeadActivity[]
  conversations      Conversation[]
  name               String
  email              String?
  phone              String?
  company            String?
  source             LeadSource          @default(MANUAL)
  status             LeadStatus          @default(NEW)
  message            String?
  estimatedValue     Decimal?            @db.Decimal(12, 2)
  nextFollowUpDate   DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([userId, createdAt])
  @@index([userId, status])
}

model LeadActivity {
  id             String           @id @default(cuid())
  leadId         String
  userId         String
  type           LeadActivityType
  title          String
  description    String?
  metadata       Json?
  conversationId String?
  messageId      String?
  createdAt      DateTime         @default(now())
  lead           Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation?    @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message        Message?         @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@unique([messageId, type])
  @@index([leadId, createdAt])
  @@index([userId, createdAt])
  @@index([conversationId, createdAt])
  @@index([messageId, createdAt])
}

model CommunicationAccount {
  id                String          @id @default(cuid())
  ownerId           String
  owner             User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  provider          MessageProvider
  displayName       String
  address           String?
  providerAccountId String
  conversations     Conversation[]
  lastImportedAt    DateTime?
  lastImportSummary Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([ownerId, provider, providerAccountId])
  @@unique([id, ownerId, provider])
  @@index([ownerId, createdAt])
}

model Conversation {
  id                     String                     @id @default(cuid())
  accountId              String
  account                CommunicationAccount       @relation(fields: [accountId, ownerId, provider], references: [id, ownerId, provider], onDelete: Cascade)
  ownerId                String
  owner                  User                       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  provider               MessageProvider
  providerConversationId String
  leadId                 String?
  lead                   Lead?                      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  subject                String?
  status                 ConversationStatus         @default(OPEN)
  classification         ConversationClassification @default(UNKNOWN)
  classificationIsManual Boolean                    @default(false)
  reviewState            ConversationReviewState    @default(NEEDS_REVIEW)
  manuallyDetached       Boolean                    @default(false)
  providerMetadata       Json?
  matchKind              ConversationMatchKind?
  matchReason            String?
  matchCandidateLeadIds  Json?
  lastMessageAt          DateTime?
  baselineImportedAt     DateTime?
  messages               Message[]
  activities             LeadActivity[]
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@unique([accountId, providerConversationId])
  @@unique([id, ownerId])
  @@unique([id, ownerId, accountId])
  @@index([ownerId, updatedAt])
  @@index([leadId, updatedAt])
  @@index([ownerId, reviewState, lastMessageAt])
  @@index([ownerId, classification, lastMessageAt])
}

model Message {
  id                   String           @id @default(cuid())
  conversationId       String
  accountId            String
  conversation         Conversation     @relation(fields: [conversationId, ownerId, accountId], references: [id, ownerId, accountId], onDelete: Cascade)
  ownerId              String
  owner                User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  providerMessageId    String
  direction            MessageDirection
  sender               String
  recipients           Json
  subject              String?
  replyTo              String?
  bodyText             String?
  bodyHtml             String?
  receivedAt           DateTime
  internetMessageId    String?
  inReplyTo            String?
  references           Json?
  externalSubmissionId String?
  sourceSystem         String?
  metadata             Json?
  activities           LeadActivity[]
  createdAt            DateTime         @default(now())

  @@unique([accountId, providerMessageId])
  @@index([ownerId, receivedAt])
  @@index([ownerId, externalSubmissionId])
}

enum LeadSource {
  MANUAL
  WEBSITE
  GMAIL
  FACEBOOK
  PHONE
}

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  PROPOSAL_SENT
  NEGOTIATING
  WON
  LOST
}

enum LeadActivityType {
  LEAD_CREATED
  WEBSITE_SUBMISSION_RECEIVED
  STATUS_CHANGED
  ESTIMATED_VALUE_CHANGED
  FOLLOW_UP_CHANGED
  CONTACT_INFO_CHANGED
  COMPANY_CHANGED
  NOTES_CHANGED
  SOURCE_CHANGED
  MESSAGE_RECEIVED
  MESSAGE_SENT
  CONVERSATION_LINKED
  CONVERSATION_UNLINKED
}

enum MessageProvider {
  FAKE
  GMAIL
  OUTLOOK
  MICROSOFT_365
  FACEBOOK_MESSENGER
  INSTAGRAM
  SMS
  WHATSAPP
}

enum ConversationStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum ConversationClassification {
  UNKNOWN
  LEAD
  CUSTOMER
  NEWSLETTER
  SPAM
  INTERNAL
  SYSTEM
}

enum ConversationReviewState {
  NEEDS_REVIEW
  MATCHED
  IGNORED
  RESOLVED
}

enum ConversationMatchKind {
  MATCHED
  AMBIGUOUS
  NO_MATCH
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leadhome?schema=public"
AUTH_SECRET="replace-with-a-random-secret"
# Optional positive integer. Defaults to 20 accepted requests per source/IP per minute.
INBOUND_RATE_LIMIT_PER_MINUTE="20"
# Google OAuth web client. Auth.js callback: /api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Exact Gmail callback registered in Google Cloud (local or production).
GOOGLE_GMAIL_REDIRECT_URI="http://localhost:3000/api/gmail/callback"
# Generate a high-entropy value of at least 32 characters; changing it requires token migration/reconnect.
TOKEN_ENCRYPTION_KEY=""
# Optional; bounded to 1-100 and defaults to 50.
GMAIL_SYNC_THREAD_LIMIT="50"
# High-entropy server-only secret used by POST /api/internal/jobs/run (40+ characters, no surrounding whitespace).
JOB_RUNNER_SECRET="replace-with-a-high-entropy-runner-secret-at-least-40-characters"
# Optional bounded job-runner settings.
JOB_MAX_ATTEMPTS="3"
JOB_STALE_AFTER_SECONDS="900"
JOBS_PER_RUN="3"
JOB_RUN_TIME_BUDGET_MS="45000"
# Local worker settings. Remote JOB_RUNNER_URL values must use HTTPS and must not contain credentials or query parameters.
JOB_RUNNER_URL="http://localhost:3000/api/internal/jobs/run"
JOB_WORKER_POLL_INTERVAL_MS="5000"
